<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{content_for(:title)} · ShelfStack" : "ShelfStack POS" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="ShelfStack">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= shelfstack_stylesheet_tags %>
    <%= javascript_importmap_tags %>
  </head>
  <% presentation = @presentation_state.presence || @workspace&.state.presence || "ready" %>
  <body class="layout-pos" data-pos-presentation="<%= presentation %>">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <main class="pos-main" id="main-content" tabindex="-1">
      <%= render "shared/flash_messages" %>
      <%= yield %>
    </main>
  </body>
</html>
