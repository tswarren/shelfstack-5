<%= form_with model: product_request, url: form_url, class: "form" do |form| %>
  <%= render "shared/form_errors", object: product_request %>

  <section class="form-section" data-controller="linked-record-pickers">
    <div class="form-grid">
      <div class="field">
        <%= form.label :request_type, "Request type", class: "field-label" %>
        <%= form.select :request_type, ProductRequest::REQUEST_TYPES.map { |t| [ t.titleize, t ] },
              {}, required: true, class: "input", disabled: product_request.persisted? %>
      </div>
      <%= render "shared/record_picker",
            form: form,
            method: :product_id,
            record_type: "product",
            selected: product_request.product,
            label: "Product",
            required: true,
            disabled: product_request.persisted?,
            picker_targets: "parent",
            data_actions: "record-picker:changed->linked-record-pickers#parentChanged",
            hint: safe_join([
              "Can't find the product? ".html_safe,
              link_to("Search or create it", new_product_import_path(return_to: request.fullpath))
            ]) %>
      <%= render "shared/record_picker",
            form: form,
            method: :product_variant_id,
            record_type: "product_variant",
            selected: product_request.product_variant,
            label: "Product variant (optional)",
            product_id: product_request.product_id,
            picker_targets: "dependent",
            hint: "Resolve the exact variant before this request is added to a purchase order." %>
      <div class="field">
        <%= form.label :requested_quantity, "Requested quantity", class: "field-label" %>
        <%= form.number_field :requested_quantity, min: 1, required: true, class: "input" %>
      </div>
      <div class="field">
        <%= form.label :priority, class: "field-label" %>
        <%= form.select :priority, ProductRequest::PRIORITIES.map { |p| [ p.titleize, p ] }, {}, class: "input" %>
      </div>
      <div class="field">
        <%= form.label :needed_by_on, "Needed by", class: "field-label" %>
        <%= form.date_field :needed_by_on, class: "input" %>
      </div>
      <% if can_lookup_customers? %>
        <%= render "shared/record_picker",
              form: form,
              method: :customer_id,
              record_type: "customer",
              selected: product_request.customer,
              label: "Customer",
              hint: safe_join([
                "Required and contactable for customer requests. ".html_safe,
                (link_to("Manage customers", customers_path) if can_view_customers?)
              ].compact) %>
      <% else %>
        <div class="field">
          <span class="field-label">Customer</span>
          <% if product_request.customer.present? %>
            <p><%= customer_association_label(product_request.customer, link_to_record: false) %></p>
            <%= form.hidden_field :customer_id %>
          <% else %>
            <p class="field-hint">Customer lookup permission is required to select a customer.</p>
          <% end %>
        </div>
      <% end %>
      <div class="field">
        <%= form.label :assigned_buyer_user_id, "Assigned buyer (optional)", class: "field-label" %>
        <%= form.collection_select :assigned_buyer_user_id, @buyers, :id, :username, { include_blank: true }, class: "input" %>
      </div>
    </div>
    <div class="field">
      <%= form.label :notes, class: "field-label" %>
      <%= form.text_area :notes, class: "input", rows: 3 %>
    </div>
  </section>

  <div class="form-actions">
    <%= form.submit(product_request.persisted? ? "Update request" : "Create request", class: "button button-primary") %>
    <%= link_to "Cancel", product_request.persisted? ? product_request_path(product_request) : product_requests_path, class: "button button-outline" %>
  </div>
<% end %>
