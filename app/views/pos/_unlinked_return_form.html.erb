<% form_url = local_assigns.fetch(:form_url)
   form_id = local_assigns.fetch(:form_id, "unlinked_return_form")
   submit_label = local_assigns.fetch(:submit_label, "Add unlinked return")
   return_reasons = local_assigns.fetch(:return_reasons)
   tax_categories = local_assigns.fetch(:tax_categories)
   price_field_id = local_assigns.fetch(:price_field_id, "unlinked_return_unit_price_cents")
   tax_field_id = local_assigns.fetch(:tax_field_id, "unlinked_return_explicit_tax_amount_cents")
   confirm_id = local_assigns.fetch(:confirm_id, "unlinked_confirm_cost_basis")
   turbo_frame = local_assigns.fetch(:turbo_frame, nil)
   selected_source = params[:return_source].presence
   selected_reason = params[:return_reason_id].presence
   selected_disposition = params[:return_disposition].presence
   selected_variant = params[:product_variant_id].presence
   selected_department = params[:department_id].presence
   selected_tax_category = params[:tax_category_id].presence
   selected_tax_basis = params[:tax_basis].presence
   selected_quantity = params[:quantity].presence || 1
   selected_description = params[:description]
   unit_price_display = params[:unit_price_cents]
   explicit_tax_display = params[:explicit_tax_amount_cents] %>

<p class="muted">
  Unlinked returns need an explicit refund price, tax basis, and (for inventory-affecting
  product returns) a confirmed cost basis.
</p>

<%= form_with url: form_url, method: :post, class: "form", id: form_id,
      data: {
        controller: "unlinked-return-tax",
        action: "change->unlinked-return-tax#sync",
        **(turbo_frame ? { turbo_frame: turbo_frame } : {})
      } do |form| %>
  <%= hidden_field_tag :mode, "unlinked" %>
  <% local_assigns.fetch(:hidden_fields, {}).each do |name, value| %>
    <%= hidden_field_tag name, value %>
  <% end %>

  <div class="form-grid">
    <div class="field">
      <%= form.label :return_source, "Return source", class: "field-label" %>
      <%= form.select :return_source, [
            [ "External receipt", "external_receipt" ],
            [ "Gift receipt", "gift_receipt" ],
            [ "No receipt", "no_receipt" ]
          ], { selected: selected_source }, class: "input", data: { unlinked_return_tax_target: "source" } %>
    </div>
    <div class="field">
      <%= form.label :return_reason_id, "Reason", class: "field-label" %>
      <%= form.collection_select :return_reason_id, return_reasons, :id, :name,
            { selected: selected_reason }, class: "input" %>
    </div>
    <div class="field">
      <%= form.label :return_disposition, "Disposition", class: "field-label" %>
      <%= form.select :return_disposition, [
            [ "Return to stock", "return_to_stock" ],
            [ "Inspection required", "inspection_required" ],
            [ "Damaged", "damaged" ],
            [ "Return to vendor", "return_to_vendor" ],
            [ "Non-inventory", "non_inventory" ]
          ], { selected: selected_disposition }, class: "input" %>
    </div>
  </div>

  <div class="form-grid">
    <div class="field">
      <%= form.label :product_variant_id, "Product variant (optional)", class: "field-label" %>
      <%= form.collection_select :product_variant_id,
            ProductVariant.joins(:product)
              .where(products: { organization_id: Current.organization.id })
              .includes(:product)
              .order("products.name", :sku)
              .limit(200),
            :id, ->(v) { "#{v.product.name} · #{v.sku}" },
            { include_blank: "Open-ring return instead", selected: selected_variant }, class: "input" %>
      <p class="field-hint">Leave blank for an open-ring return. Individually tracked items require a linked return.</p>
    </div>
    <div class="field">
      <%= form.label :department_id, "Department (open-ring)", class: "field-label" %>
      <%= form.collection_select :department_id,
            Department.sorted_hierarchically(Current.organization.departments.where(active: true, postable: true)),
            :id, :name,
            { include_blank: "—", selected: selected_department }, class: "input" %>
    </div>
    <div class="field">
      <%= form.label :description, "Description (open-ring)", class: "field-label" %>
      <%= form.text_field :description, value: selected_description, class: "input",
            placeholder: "Blank uses department name" %>
    </div>
  </div>

  <div class="form-grid">
    <%= render "shared/currency_field", name: "unit_price_cents", label: "Refund unit price",
          id: price_field_id, value: unit_price_display, value_cents: (unit_price_display.present? ? nil : 0) %>
    <div class="field">
      <%= form.label :quantity, class: "field-label" %>
      <%= form.number_field :quantity, value: selected_quantity, min: 1, class: "input input-qty" %>
    </div>
  </div>

  <div class="form-grid">
    <div class="field">
      <%= form.label :tax_category_id, "Tax category", class: "field-label" %>
      <%= form.collection_select :tax_category_id, tax_categories, :id, :name,
            { include_blank: "Use classification / department default", selected: selected_tax_category },
            class: "input" %>
    </div>
    <div class="field">
      <%= form.label :tax_basis, "Tax basis", class: "field-label" %>
      <%= form.select :tax_basis, [
            [ "Current configured rules", "current_configured_rules" ],
            [ "External receipt tax amount", "external_receipt_tax" ],
            [ "No tax refund", "no_tax_refund" ]
          ], { selected: selected_tax_basis }, class: "input", data: { unlinked_return_tax_target: "basis" } %>
    </div>
    <div data-unlinked-return-tax-target="explicitTax">
      <%= render "shared/currency_field", name: "explicit_tax_amount_cents",
            label: "Explicit tax amount (external receipt)",
            id: tax_field_id, required: false, value: explicit_tax_display, value_cents: nil,
            hint: "Only used when tax basis is External receipt tax amount." %>
    </div>
  </div>

  <div class="checkbox-group">
    <p class="muted">
      Inventory-affecting product returns show a cost proposal for confirmation on the next step.
    </p>
  </div>

  <% if Current.user.can?("pos.return.no_receipt", store: Current.store) %>
    <details class="pos-region">
      <summary>Approval (when no-receipt exceeds authority)</summary>
      <%= render "shared/approval_fields", prefix: "unlinked_return" %>
    </details>
  <% end %>

  <div class="form-actions">
    <%= form.submit submit_label, class: "button button-primary" %>
  </div>
<% end %>
