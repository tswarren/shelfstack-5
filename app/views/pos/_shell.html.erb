<%# locals: presentation:, presentation_label:, session:, primary:, summary:, summary_cta: nil, commands:, primary_commands: nil, overflow_commands: nil, hide_summary: false, hide_commands: false %>
<% presentation = local_assigns.fetch(:presentation) %>
<% presentation_label = local_assigns.fetch(:presentation_label) %>
<% session = local_assigns.fetch(:session, nil) %>
<% hide_summary = local_assigns.fetch(:hide_summary, false) %>
<% hide_commands = local_assigns.fetch(:hide_commands, false) %>
<% summary_cta = local_assigns.fetch(:summary_cta, nil) %>
<% primary_commands = local_assigns.fetch(:primary_commands, nil) %>
<% overflow_commands = local_assigns.fetch(:overflow_commands, nil) %>
<% shell_modifier = hide_summary ? "pos-shell--no-summary" : "pos-shell--with-summary" %>

<div data-controller="pos-overlay">
  <%= turbo_frame_tag "pos_workspace",
        target: "_top",
        class: "pos-workspace-frame" do %>
    <div class="pos-shell <%= shell_modifier %>"
         data-controller="pos-register"
         data-pos-presentation="<%= presentation %>"
         data-pos-register-scan-outcome-value="<%= @scan_outcome %>"
         data-pos-register-focus-target-value="<%= @focus_target %>"
         data-pos-register-completed-value="<%= presentation == "receipt" %>">
      <span hidden data-pos-register-target="announce"><%= flash[:notice].presence || flash[:alert] %></span>
      <div class="pos-live-region" role="status" aria-live="polite" data-pos-register-target="liveRegion"></div>

      <%= render "pos/register_header",
            presentation: presentation,
            presentation_label: presentation_label,
            session: session %>

      <div class="pos-shell__workspace">
        <div class="pos-shell__primary" id="pos-primary">
          <%= primary %>
        </div>
        <% unless hide_summary %>
          <aside class="pos-shell__summary" id="pos-summary" aria-label="Summary">
            <div class="pos-shell__summary-scroll">
              <%= summary %>
            </div>
            <% if summary_cta.present? %>
              <div class="pos-summary-cta">
                <%= summary_cta %>
              </div>
            <% end %>
          </aside>
        <% end %>
      </div>

      <% unless hide_commands %>
        <div class="pos-shell__commands" id="pos-commands" role="toolbar" aria-label="POS commands">
          <% if primary_commands || overflow_commands %>
            <div class="pos-commands-primary">
              <%= primary_commands %>
            </div>
            <% if overflow_commands.present? %>
              <details class="pos-commands-overflow">
                <summary class="button button-outline button-small">More</summary>
                <div class="pos-commands-overflow__menu">
                  <%= overflow_commands %>
                </div>
              </details>
            <% end %>
          <% else %>
            <div class="pos-commands-primary">
              <%= commands %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= turbo_frame_tag "pos_overlay",
        class: "pos-overlay-frame",
        data: { action: "turbo:frame-load->pos-overlay#onFrameLoad" } do %>
    <% if @pending_approval_action.present? %>
      <%= render "pos_overlays/approval_interrupt", pending: @pending_approval_action %>
    <% end %>
  <% end %>
</div>
