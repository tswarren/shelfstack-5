<% tp = local_assigns.fetch(:presentation) %>
<%= form_with url: pos_transaction_pos_tenders_path(@pos_transaction), method: :post,
      class: "form", id: tp.active_form_id do |form| %>
  <%= hidden_field_tag :tender_method, "stored_value" %>
  <div class="field">
    <%= form.label :tender_type_id, "Tender type", class: "field-label" %>
    <%= form.collection_select :tender_type_id, tp.stored_value_types, :id, :name, {}, class: "input" %>
  </div>
  <div class="field">
    <%= form.label :account_number, "Account number", class: "field-label" %>
    <%= form.text_field :account_number, class: "input", autocomplete: "off",
          value: params[:account_number] %>
  </div>
  <%= render "shared/currency_field", name: "amount_cents", label: "Amount",
        id: "sv_tender_amount_cents", value_cents: [ @balance_due_cents, 0 ].max %>
<% end %>
