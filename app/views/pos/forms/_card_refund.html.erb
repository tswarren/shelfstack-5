<% tp = local_assigns.fetch(:presentation) %>
<% card_type = tp.card_types.first %>
<% refundable_card = tp.refundable_original_tenders.select { |t| t.tender_type.tender_category == "card" } %>
<%= form_with url: pos_transaction_pos_tenders_path(@pos_transaction), method: :post,
      class: "form", id: tp.active_form_id do |form| %>
  <%= hidden_field_tag :tender_method, "card" %>
  <%= hidden_field_tag :refund, "1" %>
  <%= hidden_field_tag :recording_idempotency_key, SecureRandom.uuid %>
  <p class="muted">Process the refund on the external terminal, then record the new authorization references here.</p>
  <div class="field">
    <%= form.label :tender_type_id, "Card type", class: "field-label" %>
    <%= form.collection_select :tender_type_id, tp.card_types, :id, :name,
          { selected: card_type&.id }, class: "input" %>
  </div>
  <% if refundable_card.any? %>
    <div class="field">
      <%= form.label :original_pos_tender_id, "Original card tender", class: "field-label" %>
      <%= form.select :original_pos_tender_id,
            refundable_card.map { |t| [ pos_original_card_tender_option_label(t), t.id ] },
            { include_blank: "Select original… (or exception below)" },
            class: "input" %>
    </div>
  <% end %>
  <%= render "shared/currency_field", name: "amount_cents", label: "Refund amount",
        id: "card_refund_amount_cents", value_cents: -@balance_due_cents %>
  <div class="field">
    <%= form.label :authorization_code, card_type&.reference_1_label.presence || "Authorization code", class: "field-label" %>
    <%= form.text_field :authorization_code, class: "input",
          required: card_type&.reference_1_requirement == "required" %>
  </div>
  <div class="field">
    <%= form.label :terminal_reference, card_type&.reference_2_label.presence || "Terminal reference", class: "field-label" %>
    <%= form.text_field :terminal_reference, class: "input",
          required: card_type&.reference_2_requirement == "required" %>
  </div>
  <%= render "pos_transactions/refund_exception_fields", form: form, prefix: "card_refund" %>
<% end %>
