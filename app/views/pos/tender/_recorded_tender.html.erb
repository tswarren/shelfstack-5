<% tp = local_assigns.fetch(:presentation) %>
<% tender = local_assigns.fetch(:tender) %>
<% selected = tp.selected_tender&.id == tender.id %>
<li class="pos-recorded-tender <%= 'pos-recorded-tender--selected' if selected %>">
  <% if @pos_transaction.open? && tender.unresolved? && !@pos_transaction.void_required_tenders? %>
    <%= link_to tender_pos_transaction_path(
          @pos_transaction,
          tender_method: tp.selected_method,
          selected_tender_id: tender.id,
          intent: @entry_intent
        ),
          class: "pos-recorded-tender__select",
          aria: { current: (selected ? "true" : nil) },
          data: { turbo_frame: "_top", turbo_action: "replace" } do %>
      <span class="pos-recorded-tender__marker" aria-hidden="true"><%= selected ? "●" : "○" %></span>
      <span>
        <strong><%= tender.tender_type.name %></strong>
        · <%= tender.direction == "refunded" ? "refund" : "payment" %>
        · <%= pos_money(tender.amount_cents) %>
        <span class="muted"><%= tender.status.humanize %></span>
        <% if tender.authorization_code.present? || tender.terminal_reference.present? %>
          <span class="muted"><%= tender.authorization_code || tender.terminal_reference %></span>
        <% end %>
      </span>
    <% end %>
  <% else %>
    <span class="pos-recorded-tender__static">
      <strong><%= tender.tender_type.name %></strong>
      · <%= tender.direction == "refunded" ? "refund" : "payment" %>
      · <%= pos_money(tender.amount_cents) %>
      <span class="muted"><%= tender.status.humanize %></span>
    </span>
  <% end %>
</li>
