<% line = local_assigns.fetch(:line) %>
<% sign = line.return? ? -1 : 1 %>
<% extended_cents = line.extended_price_cents.to_i * sign %>
<% allocations = line.pos_discount_allocations.to_a %>
<% discount_cents = allocations.sum { |allocation| allocation.allocated_amount_cents.to_i } %>
<% net_cents = (line.extended_price_cents.to_i - discount_cents) * sign %>
<% sv_details = @facts.stored_value_details_by_line_id[line.id] %>
<% identifier = if line.line_kind == "stored_value"
     sv_details&.dig(:masked_account)
   else
     pos_receipt_line_identifier(line)
   end %>
<% markers = @facts.tax_markers_by_line_id.fetch(line.id, []) %>
<% marker_text = markers.join(" ") %>
<% show_qty_detail = line.quantity.to_i > 1 && line.line_kind != "stored_value" %>
<% original_receipt = line.original_pos_line_item&.pos_transaction&.receipt_number %>

<article class="pos-receipt-item<%= " pos-receipt-item--return" if line.return? %>">
  <p class="pos-receipt-item__description">
    <%= pos_receipt_line_description(line) %>
  </p>

  <p class="pos-receipt-item__row pos-receipt-item__row--primary">
    <span class="pos-receipt-item__identifier"><%= identifier %></span>
    <span class="amount"><%= pos_money(extended_cents) %></span>
    <span class="pos-receipt-tax-markers"><%= marker_text %></span>
  </p>

  <% if show_qty_detail %>
    <p class="pos-receipt-item__detail"><%= line.quantity %> @ <%= pos_money(line.unit_price_cents) %></p>
  <% end %>

  <% if line.line_kind == "stored_value" && sv_details&.dig(:new_balance_cents) %>
    <p class="pos-receipt-item__detail">New Balance: <%= pos_money(sv_details[:new_balance_cents]) %></p>
  <% end %>

  <% allocations.each do |allocation| %>
    <% next unless allocation.allocated_amount_cents.to_i.positive? %>
    <p class="pos-receipt-item__row pos-receipt-item__row--adjustment">
      <span><%= pos_receipt_discount_label(allocation.pos_discount) %></span>
      <span class="amount"><%= pos_money(-allocation.allocated_amount_cents.to_i * sign) %></span>
      <span class="pos-receipt-tax-markers" aria-hidden="true"></span>
    </p>
  <% end %>

  <% if discount_cents.positive? %>
    <p class="pos-receipt-item__row pos-receipt-item__row--net">
      <span>Net</span>
      <span class="amount"><%= pos_money(net_cents) %></span>
      <span class="pos-receipt-tax-markers" aria-hidden="true"></span>
    </p>
  <% end %>

  <% if line.return? && original_receipt.present? %>
    <p class="pos-receipt-item__detail">Original Receipt: <%= original_receipt %></p>
  <% end %>
</article>
