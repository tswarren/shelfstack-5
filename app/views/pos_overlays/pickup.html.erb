<%= turbo_frame_tag "pos_overlay" do %>
  <%= render layout: "pos_overlays/dialog", locals: { title: "Pickup / Product Request" } do %>
    <p class="muted">
      Search by customer number, name, or request id, then start a transaction with
      the pickup line.
    </p>
    <%= form_with url: pos_overlay_pickup_path, method: :get, class: "form" do %>
      <div class="field">
        <label class="field-label" for="pickup_q">Customer or request</label>
        <%= text_field_tag :q, @pickup_query, id: "pickup_q", class: "input",
              autofocus: true, placeholder: "Customer number, name, or request id",
              autocomplete: "off" %>
      </div>
      <div class="form-actions">
        <%= submit_tag "Search", class: "button button-primary" %>
      </div>
    <% end %>

    <% if @pickup_query.blank? %>
      <p class="muted">Enter a customer or request reference to find fulfillable pickups.</p>
    <% elsif @fulfillable_customer_requests.blank? %>
      <p class="muted">No open customer requests matched that reference at this store.</p>
    <% else %>
      <%= form_with url: register_start_pickup_path, method: :post, class: "form",
            data: { turbo_frame: "_top" } do |form| %>
        <div class="field">
          <%= form.label :product_request_id, "Customer request", class: "field-label" %>
          <%= form.select :product_request_id,
                @fulfillable_customer_requests.map { |request|
                  label = [
                    "##{request.id}",
                    request.customer&.display_name.presence,
                    request.product_variant&.name.presence || request.product&.name,
                    "qty #{request.outstanding_quantity}"
                  ].compact.join(" · ")
                  [ label, request.id ]
                },
                { include_blank: "Select a request…" },
                class: "input",
                required: true %>
        </div>
        <div class="field">
          <label class="field-label" for="ready_pickup_quantity">Qty</label>
          <%= number_field_tag :quantity, 1, id: "ready_pickup_quantity", min: 1, class: "input input-qty" %>
        </div>
        <div class="form-actions">
          <%= form.submit "Start with pickup", class: "button button-primary" %>
        </div>
      <% end %>
    <% end %>
    <% if Current.user.can?("requests.product_request.view", store: Current.store) %>
      <p class="field-hint">
        <%= link_to "Browse all product requests", product_requests_path,
              class: "button button-small button-ghost", data: { turbo_frame: "_top" } %>
      </p>
    <% end %>
  <% end %>
<% end %>
