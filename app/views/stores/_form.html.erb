<%= form_with model: store, class: "form" do |form| %>
  <%= render "shared/form_errors", object: store %>

  <section class="form-section">
    <h2 class="form-section-title">Store details</h2>
    <div class="form-grid">
      <div class="field">
        <%= form.label :code, class: "field-label" %>
        <%= form.text_field :code, class: "input input-code" %>
      </div>
      <div class="field">
        <%= form.label :name, class: "field-label" %>
        <%= form.text_field :name, class: "input" %>
      </div>
      <div class="field">
        <%= form.label :timezone, class: "field-label" %>
        <%= form.text_field :timezone, class: "input" %>
        <p class="field-hint">IANA time zone, e.g. America/New_York.</p>
      </div>
      <div class="field">
        <%= form.label :currency_code, class: "field-label" %>
        <%= form.text_field :currency_code, class: "input input-code", maxlength: 3 %>
        <p class="field-hint">ISO 4217 code, e.g. USD.</p>
      </div>
    </div>
    <div class="checkbox-group">
      <label><%= form.check_box :active %> Store is active</label>
    </div>
  </section>

  <section class="form-section">
    <h2 class="form-section-title">Location</h2>
    <p class="field-hint">Used as defaults for new customer addresses and phone parsing.</p>
    <div class="form-grid">
      <div class="field">
        <%= form.label :region, "State / province", class: "field-label" %>
        <%= form.text_field :region, class: "input" %>
      </div>
      <div class="field">
        <%= form.label :country_code, "Country", class: "field-label" %>
        <%= form.select :country_code,
              country_code_options_for_select(selected: store.country_code),
              { include_blank: "—" },
              class: "input" %>
      </div>
    </div>
  </section>

  <section class="form-section">
    <h2 class="form-section-title">Receipt text</h2>
    <p class="field-hint">Printed on browser receipts. Changing these fields affects later prints only — not completed transaction amounts.</p>
    <div class="form-stack">
      <div class="field">
        <%= form.label :receipt_header, class: "field-label" %>
        <%= form.text_area :receipt_header, class: "input", rows: 3 %>
      </div>
      <div class="field">
        <%= form.label :receipt_footer, class: "field-label" %>
        <%= form.text_area :receipt_footer, class: "input", rows: 3 %>
      </div>
      <div class="field">
        <%= form.label :gift_receipt_footer, "Gift receipt footer", class: "field-label" %>
        <%= form.text_area :gift_receipt_footer, class: "input", rows: 3 %>
        <p class="field-hint">Shown on Gift Receipts. Leave blank to use a short default message.</p>
      </div>
    </div>
  </section>

  <div class="form-actions">
    <%= form.submit store.persisted? ? "Update store" : "Create store", class: "button button-primary" %>
    <%= link_to "Cancel", store.persisted? ? store_path(store) : stores_path, class: "button button-outline" %>
  </div>
<% end %>
