<% if @pos_transaction.editable? %>
  <%
    preserve_scan = %w[failed ambiguous].include?(@scan_outcome.to_s)
    scan_value = preserve_scan ? @scan_query.to_s : nil
  %>

  <% if @return_lookup_transaction.present? && Current.user.can?("pos.return.create", store: Current.store) %>
    <div class="ss-alert ss-alert-info pos-region" role="status">
      <p>
        Linked return ready for receipt
        <strong><%= @return_lookup_transaction.receipt_number %></strong>.
      </p>
      <%= link_to "Continue return",
            pos_overlay_start_return_path(pos_transaction_id: @pos_transaction.id),
            class: "button button-small button-outline",
            data: pos_overlay_turbo %>
    </div>
  <% end %>

  <section class="pos-region" aria-label="Scan or search">
    <%= form_with url: pos_transaction_pos_line_items_path(@pos_transaction), method: :post,
          class: "pos-entry-bar",
          data: pos_workspace_turbo.merge(
            "pos-register-target": "scanForm",
            action: "submit->pos-register#startScanProcessing"
          ) do |form| %>
      <%= hidden_field_tag :intent, "sale" %>
      <div class="field">
        <label class="field-label" for="scan_query">Scan or search</label>
        <%= form.text_field :query, id: "scan_query", placeholder: "ISBN / SKU / unit ID",
              autocomplete: "off", class: "input",
              value: scan_value,
              data: { "pos-register-target": "scanInput" } %>
      </div>
      <div class="field">
        <label class="field-label" for="scan_quantity">Qty</label>
        <%= form.number_field :quantity, id: "scan_quantity", value: 1, min: 1, class: "input input-qty" %>
      </div>
      <% if @fulfillable_customer_requests.present? %>
        <div class="field">
          <label class="field-label" for="scan_product_request_id">Request</label>
          <%= form.select :product_request_id,
                @fulfillable_customer_requests.map { |request|
                  label = "##{request.id} — #{request.product.name}"
                  label += " / #{request.product_variant.name}" if request.product_variant
                  label += " (#{request.outstanding_quantity})"
                  [ label, request.id ]
                },
                { include_blank: "None" },
                id: "scan_product_request_id", class: "input" %>
        </div>
      <% end %>
      <%= form.submit "Add", class: "button button-primary" %>
      <%= link_to "Lookup",
            pos_overlay_product_lookup_path(pos_transaction_id: @pos_transaction.id, intent: "sale"),
            class: "button button-outline",
            data: pos_overlay_turbo %>
    <% end %>
    <%= render "scan_resolution" %>
  </section>
<% end %>
