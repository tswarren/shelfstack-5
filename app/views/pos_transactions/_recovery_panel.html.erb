<% if @presentation_state == "recovery" %>
  <section class="pos-panel pos-recovery-panel" aria-label="Recovery" data-pos-register-target="recoveryPanel">
    <h2>Recovery</h2>
    <p class="muted">Closed recovery list for Phase 11 begins with <code>void_required</code> only.</p>
    <% if @pos_transaction.void_required_tenders? %>
      <p role="alert">
        <strong>Code:</strong> void_required<br>
        External card activity needs confirmation. Verify the terminal or processor void, then record the outcome below.
        Do not add another tender or edit commercial lines until Recovery is resolved.
      </p>
      <%= render "void_required_tenders" %>
    <% else %>
      <p class="muted">Resolve the condition shown in readiness, then continue.</p>
    <% end %>
  </section>
<% end %>
