<%
  selected = @selected_line_id == line.id
  discount_cents = @line_discount_cents_by_id ? @line_discount_cents_by_id.fetch(line.id, 0) : line.discount_amount_cents.to_i
  tax_cents = @line_tax_cents_by_id ? @line_tax_cents_by_id.fetch(line.id, 0) : line.tax_amount_cents.to_i
  net_cents = line.extended_price_cents - discount_cents + tax_cents
  row_classes = [
    ("pos-line-return" if line.return?),
    ("pos-line-selected" if selected)
  ].compact.join(" ")
%>
<tr class="<%= row_classes %>">
  <td>
    <% if @pos_transaction.editable? %>
      <%= link_to line.effective_description,
            pos_transaction_path(@pos_transaction, intent: @entry_intent, selected_line_id: line.id, focus_target: "line_actions"),
            class: "pos-line-select-link",
            data: pos_workspace_turbo,
            aria: { current: (selected ? "true" : nil) } %>
    <% else %>
      <%= line.effective_description %>
    <% end %>
    <% if line.return? %>
      <span class="pos-line-meta">Return of line #<%= line.original_pos_line_item_id %> · <%= line.return_reason&.name %> · <%= line.return_disposition&.humanize %></span>
    <% end %>
    <% if line.inventory_unit.present? %>
      <span class="pos-line-meta">Unit <%= line.inventory_unit.unit_identifier %></span>
    <% end %>
  </td>
  <td class="num"><%= line.quantity %></td>
  <td class="num"><%= pos_money(line.unit_price_cents) %></td>
  <td class="num"><%= pos_money(line.extended_price_cents) %></td>
  <td class="num"><%= pos_money(discount_cents) %></td>
  <td class="num"><%= pos_money(tax_cents) %></td>
  <td class="num"><%= pos_money(net_cents) %></td>
</tr>
<% if @pos_transaction.editable? && line.sale? && line.line_kind != "stored_value" && line.tax_category_overridden? %>
  <tr class="pos-line-detail-row">
    <td colspan="7">
      Tax overridden: <%= line.original_tax_category&.name %> → <%= line.tax_category&.name %> — <%= line.tax_category_override_reason %>
    </td>
  </tr>
<% end %>
