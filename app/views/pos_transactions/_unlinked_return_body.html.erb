<p class="muted">
  Unlinked returns need an explicit refund price and tax basis. Use this when there is no
  original ShelfStack sale line to reverse.
</p>

<%= form_with url: pos_transaction_pos_return_lines_path(@pos_transaction), method: :post,
      class: "form", id: "unlinked_return_form" do |form| %>
  <%= hidden_field_tag :mode, "unlinked" %>
  <%= hidden_field_tag :intent, "sale" %>

  <div class="form-grid">
    <div class="field">
      <%= form.label :return_source, "Return source", class: "field-label" %>
      <%= form.select :return_source, [
            [ "External receipt", "external_receipt" ],
            [ "Gift receipt", "gift_receipt" ],
            [ "No receipt", "no_receipt" ]
          ], {}, class: "input" %>
    </div>
    <div class="field">
      <%= form.label :return_reason_id, "Reason", class: "field-label" %>
      <%= form.collection_select :return_reason_id, @return_reasons, :id, :name, {}, class: "input" %>
    </div>
    <div class="field">
      <%= form.label :return_disposition, "Disposition", class: "field-label" %>
      <%= form.select :return_disposition, [
            [ "Return to stock", "return_to_stock" ],
            [ "Inspection required", "inspection_required" ],
            [ "Damaged", "damaged" ],
            [ "Return to vendor", "return_to_vendor" ],
            [ "Discard", "discard" ],
            [ "Non-inventory", "non_inventory" ]
          ], {}, class: "input" %>
    </div>
  </div>

  <div class="form-grid">
    <div class="field">
      <%= form.label :product_variant_id, "Product variant (optional)", class: "field-label" %>
      <%= form.collection_select :product_variant_id,
            ProductVariant.joins(:product)
              .where(products: { organization_id: Current.organization.id })
              .includes(:product)
              .order("products.name", :sku)
              .limit(200),
            :id, ->(v) { "#{v.product.name} · #{v.sku}" },
            { include_blank: "Open-ring return instead" }, class: "input" %>
      <p class="field-hint">Leave blank for an open-ring return. Individually tracked items require a linked return.</p>
    </div>
    <div class="field">
      <%= form.label :department_id, "Department (open-ring)", class: "field-label" %>
      <%= form.collection_select :department_id,
            Department.sorted_hierarchically(Current.organization.departments.where(active: true, postable: true)),
            :id, :name,
            { include_blank: "—" }, class: "input" %>
    </div>
    <div class="field">
      <%= form.label :description, "Description (open-ring)", class: "field-label" %>
      <%= form.text_field :description, class: "input", placeholder: "Blank uses department name" %>
    </div>
  </div>

  <div class="form-grid">
    <%= render "shared/currency_field", name: "unit_price_cents", label: "Refund unit price",
          id: "unlinked_return_unit_price_cents" %>
    <div class="field">
      <%= form.label :quantity, class: "field-label" %>
      <%= form.number_field :quantity, value: 1, min: 1, class: "input input-qty" %>
    </div>
  </div>

  <% if Current.user.can?("pos.return.no_receipt", store: Current.store) %>
    <details class="pos-region">
      <summary>Approval (when no-receipt exceeds authority)</summary>
      <%= render "shared/approval_fields", prefix: "unlinked_return" %>
    </details>
  <% end %>

  <div class="form-actions">
    <%= form.submit "Add unlinked return", class: "button button-outline" %>
  </div>
<% end %>
