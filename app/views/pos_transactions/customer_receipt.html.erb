<% content_for :title, "Receipt #{@pos_transaction.receipt_number}" %>
<% net_merchandise_cents = @pos_transaction.subtotal_cents.to_i - @pos_transaction.discount_total_cents.to_i %>
<% document_banner = pos_receipt_document_banner(@pos_transaction) %>

<div class="pos-receipt-toolbar no-print">
  <p class="muted">Browser print path only — no managed printer queue.</p>
  <div class="action-group">
    <button type="button" class="button button-primary" onclick="window.print()">Print</button>
    <%= link_to "Back to receipt", pos_transaction_path(@pos_transaction), class: "button button-outline" %>
    <%= link_to "Register", register_path, class: "button button-ghost" %>
  </div>
</div>

<article class="pos-customer-receipt" aria-label="Customer receipt">
  <% if @reprint %>
    <p class="pos-receipt-reprint" role="status"><strong>REPRINT</strong></p>
  <% end %>

  <% if document_banner.present? && document_banner != "RECEIPT" %>
    <p class="pos-receipt-banner" role="status"><strong><%= document_banner %></strong></p>
  <% end %>

  <header class="pos-receipt-header">
    <h1><%= Current.store.name %></h1>
    <p class="muted"><%= Current.organization.name %></p>
    <% pos_store_address_lines.each do |line| %>
      <p class="muted"><%= line %></p>
    <% end %>
    <% if Current.store.receipt_header.present? %>
      <p class="pos-receipt-store-text"><%= simple_format(Current.store.receipt_header) %></p>
    <% end %>
  </header>

  <p>
    Receipt <strong><%= @pos_transaction.receipt_number %></strong><br>
    <span class="muted"><%= formatted_datetime(@pos_transaction.completed_at, format: :receipt) %></span>
  </p>

  <% if @receipt_register_label.present? || @receipt_cashier_label.present? %>
    <p class="muted">
      <% if @receipt_register_label.present? %>Register <%= @receipt_register_label %><% end %>
      <% if @receipt_register_label.present? && @receipt_cashier_label.present? %> · <% end %>
      <% if @receipt_cashier_label.present? %>Cashier: <%= @receipt_cashier_label %><% end %>
    </p>
  <% end %>

  <% if @pos_transaction.reverses_pos_transaction.present? %>
    <p class="muted">Original receipt <%= @pos_transaction.reverses_pos_transaction.receipt_number %></p>
  <% end %>

  <% if @pos_transaction.customer.present? && can_lookup_customers? %>
    <p>
      Customer: <%= @pos_transaction.customer.display_name %>
      <code><%= @pos_transaction.customer.customer_number %></code>
    </p>
  <% end %>

  <section class="pos-receipt-lines" aria-label="Merchandise">
    <% @receipt_lines.each do |line| %>
      <%= render "customer_receipt_line", line: line %>
    <% end %>
  </section>

  <dl class="definition-grid pos-totals">
    <div class="definition-item"><dt>Merchandise</dt><dd><%= pos_money(@pos_transaction.subtotal_cents) %></dd></div>
    <% if @pos_transaction.discount_total_cents.to_i.positive? %>
      <div class="definition-item"><dt>Discounts</dt><dd><%= pos_money(-@pos_transaction.discount_total_cents) %></dd></div>
      <div class="definition-item"><dt>Net merchandise</dt><dd><%= pos_money(net_merchandise_cents) %></dd></div>
    <% end %>
    <% if @receipt_tax_components.present? %>
      <% @receipt_tax_components.each do |component| %>
        <div class="definition-item">
          <dt><%= component[:label] %></dt>
          <dd><%= pos_money(component[:amount_cents]) %></dd>
        </div>
      <% end %>
    <% else %>
      <div class="definition-item"><dt>Tax</dt><dd><%= pos_money(@pos_transaction.tax_total_cents) %></dd></div>
    <% end %>
    <div class="definition-item"><dt>Total</dt><dd class="pos-balance"><%= pos_money(@pos_transaction.net_total_cents) %></dd></div>
  </dl>

  <% if @receipt_tenders.any? %>
    <h2>Tenders</h2>
    <ul class="pos-tender-summary">
      <% @receipt_tenders.each do |tender| %>
        <li>
          <%= tender.tender_type.name %> · <%= tender.direction.humanize %> ·
          <%= pos_money(tender.amount_cents) %>
          <% if tender.change_due_cents.to_i.positive? %>
            <span class="muted">(change <%= pos_money(tender.change_due_cents) %>)</span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if Current.store.receipt_footer.present? %>
    <div class="pos-receipt-store-text muted"><%= simple_format(Current.store.receipt_footer) %></div>
  <% else %>
    <p class="muted pos-receipt-footer">Thank you.</p>
  <% end %>
</article>
