<% if @pos_transaction.editable? %>
  <div class="pos-commands-selected" aria-label="Selected line actions"
       data-pos-register-target="lineActions">
    <% if @selected_line.blank? %>
      <span class="muted">Select a line</span>
    <% else %>
      <% line = @selected_line %>
      <span class="pos-commands-selected__label" title="<%= line.effective_description %>">
        <%= truncate(line.effective_description, length: 28) %>
      </span>
      <% if line.sale? && line.inventory_unit.blank? && line.line_kind != "stored_value" %>
        <%= form_with url: pos_transaction_pos_line_item_path(@pos_transaction, line), method: :patch,
              class: "pos-inline-form", data: pos_workspace_turbo do |form| %>
          <%= hidden_field_tag :intent, @entry_intent %>
          <%= hidden_field_tag :selected_line_id, line.id %>
          <%= hidden_field_tag :focus_target, "line_actions" %>
          <%= form.number_field :quantity, value: line.quantity, min: 1, class: "input input-qty",
                aria: { label: "Quantity" } %>
          <%= form.submit "Qty", class: "button button-small button-outline" %>
        <% end %>
      <% end %>
      <% if Current.user.can?("pos.line.remove", store: Current.store) %>
        <%= button_to "Remove", pos_transaction_pos_line_item_path(@pos_transaction, line),
              method: :delete,
              class: "button button-small button-danger",
              params: { intent: @entry_intent, focus_target: "scan" },
              form: { data: pos_workspace_turbo } %>
      <% end %>
      <% if line.sale? && line.line_kind != "stored_value" %>
        <%= link_to "Discount",
              pos_overlay_line_actions_path(pos_transaction_id: @pos_transaction.id, line_id: line.id, intent: @entry_intent, section: "discount"),
              class: "button button-small button-outline",
              data: pos_overlay_turbo %>
        <% if line.line_kind == "product" %>
          <%= link_to "Price",
                pos_overlay_line_actions_path(pos_transaction_id: @pos_transaction.id, line_id: line.id, intent: @entry_intent, section: "price"),
                class: "button button-small button-outline",
                data: pos_overlay_turbo %>
        <% end %>
        <%= link_to "Tax",
              pos_overlay_line_actions_path(pos_transaction_id: @pos_transaction.id, line_id: line.id, intent: @entry_intent, section: "tax"),
              class: "button button-small button-ghost",
              data: pos_overlay_turbo %>
      <% end %>
    <% end %>
  </div>
<% end %>
