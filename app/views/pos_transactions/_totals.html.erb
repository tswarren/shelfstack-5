<section class="pos-region" aria-label="Totals">
  <h3>Totals</h3>
  <dl class="pos-totals">
    <div class="definition-item"><dt>Subtotal</dt><dd><%= pos_money(@subtotal_cents) %></dd></div>
    <div class="definition-item"><dt>Discount</dt><dd><%= pos_money(@discount_total_cents) %></dd></div>
    <div class="definition-item"><dt>Tax</dt><dd><%= pos_money(@tax_total_cents) %></dd></div>
    <div class="definition-item"><dt>Net total</dt><dd><strong><%= pos_money(@net_total_cents) %></strong></dd></div>
    <div class="definition-item"><dt>Tendered</dt><dd><%= pos_money(@tendered_total_cents) %></dd></div>
  </dl>

  <% if @pos_transaction.open? %>
    <% if @balance_due_cents.zero? %>
      <p class="pos-kv">
        <span class="pos-kv__label">Settled</span>
        <span class="pos-kv__value pos-balance"><%= pos_money(0) %></span>
      </p>
    <% elsif @balance_due_cents.negative? %>
      <p class="pos-kv">
        <span class="pos-kv__label">Refund due</span>
        <span class="pos-kv__value pos-balance"><%= pos_money(-@balance_due_cents) %></span>
      </p>
    <% else %>
      <p class="pos-kv">
        <span class="pos-kv__label">Amount due</span>
        <span class="pos-kv__value pos-balance"><%= pos_money(@balance_due_cents) %></span>
      </p>
    <% end %>
    <% if @change_due_cents.to_i.positive? %>
      <p class="pos-kv">
        <span class="pos-kv__label">Change due</span>
        <span class="pos-kv__value pos-balance pos-change"><%= pos_money(@change_due_cents) %></span>
      </p>
    <% end %>
  <% end %>
</section>
