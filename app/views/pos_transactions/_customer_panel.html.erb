<section class="pos-region" aria-label="Customer">
  <h3>Customer</h3>
  <% if @pos_transaction.customer.present? %>
    <% if can_lookup_customers? %>
      <p>
        <strong><%= @pos_transaction.customer.display_name %></strong>
        <code><%= @pos_transaction.customer.customer_number %></code>
      </p>
      <% if @pos_transaction.editable? %>
        <%= button_to "Remove", remove_customer_pos_transaction_path(@pos_transaction),
              method: :post, class: "button button-ghost button-small",
              form: { data: pos_workspace_turbo } %>
      <% end %>
    <% else %>
      <p class="muted">Customer attached.</p>
    <% end %>
  <% elsif @pos_transaction.editable? && can_lookup_customers? %>
    <%= form_with url: attach_customer_pos_transaction_path(@pos_transaction), method: :post, class: "form",
          data: pos_workspace_turbo do %>
      <%= render "shared/record_picker",
            name: "customer_id",
            id: "attach_customer_id",
            record_type: "customer",
            label: "Attach customer",
            required: true,
            include_blank: false,
            hint: "Name, phone, email, or number." %>
      <%= submit_tag "Attach", class: "button button-outline button-small" %>
    <% end %>
    <% if Current.user.can?("customers.customer.create", store: Current.store) %>
      <p class="field-hint">
        <%= link_to "Create customer", new_customer_path, class: "button button-small button-ghost",
              data: { turbo_frame: "_top" } %>
      </p>
    <% end %>
  <% else %>
    <p class="muted">No customer attached.</p>
  <% end %>
</section>
