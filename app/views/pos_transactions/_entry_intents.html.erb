<% if @pos_transaction.editable? %>
  <section class="pos-region" aria-label="Entry intent">
    <h2 class="sr-only">Entry intent</h2>
    <div class="action-group" role="group" aria-label="Current entry intent">
      <%= link_to "Sale",
            pos_transaction_path(@pos_transaction, selected_line_id: @selected_line_id),
            class: "button button-small button-primary",
            aria: { current: "true" },
            data: {
              turbo_frame: "_top",
              turbo_action: "replace",
              "pos-register-target": "saleIntent"
            } %>
      <% if Current.user.can?("pos.return.create", store: Current.store) %>
        <%= link_to "Return",
              pos_overlay_start_return_path(pos_transaction_id: @pos_transaction.id),
              class: "button button-small button-outline",
              data: pos_overlay_turbo %>
      <% end %>
      <% if Current.user.can?("stored_value.issue", store: Current.store) ||
            Current.user.can?("stored_value.reload", store: Current.store) %>
        <%= link_to "Stored value",
              pos_overlay_stored_value_path(pos_transaction_id: @pos_transaction.id),
              class: "button button-small button-outline",
              data: pos_overlay_turbo %>
      <% end %>
      <%= link_to "Open ring",
            pos_overlay_open_ring_path(pos_transaction_id: @pos_transaction.id),
            class: "button button-small button-outline",
            data: pos_overlay_turbo %>
    </div>
  </section>
<% end %>
