<% if @pos_transaction.completed? %>
  <% content_for :head do %>
    <meta name="turbo-cache-control" content="no-cache">
  <% end %>
  <% primary = capture do %>
    <section class="pos-panel pos-completed-summary" aria-label="Completed transaction">
      <h2>Transaction complete</h2>
      <p class="pos-receipt-number">Receipt <strong><%= @pos_transaction.receipt_number %></strong></p>
      <p class="muted">Completed <%= formatted_datetime(@pos_transaction.completed_at, format: :short) %></p>
      <% if @pos_transaction.customer.present? %>
        <% if can_lookup_customers? %>
          <p>Customer: <strong><%= @pos_transaction.customer.display_name %></strong>
            <code><%= @pos_transaction.customer.customer_number %></code></p>
        <% else %>
          <p class="muted">Customer attached.</p>
        <% end %>
      <% end %>

      <% if @change_due_cents.to_i.positive? %>
        <p class="pos-balance pos-change">Change due <%= pos_money(@change_due_cents) %></p>
      <% end %>

      <% if @pos_tenders.any? %>
        <h3>Tenders</h3>
        <ul class="pos-tender-summary">
          <% @pos_tenders.each do |tender| %>
            <li>
              <%= tender.tender_type.name %> · <%= tender.direction.humanize %> ·
              <%= pos_money(tender.amount_cents) %>
              <% if tender.change_due_cents.to_i.positive? %>
                <span class="muted">(change <%= pos_money(tender.change_due_cents) %>)</span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>

      <div class="form-actions">
        <%= link_to "Next transaction", register_path, class: "button button-primary button-large",
              data: { turbo_frame: "_top", "pos-register-target": "backToRegister" },
              autofocus: true %>
      </div>
      <p class="field-hint">Press Enter to start the next transaction from Ready.</p>
    </section>
  <% end %>

  <% primary_commands = capture do %>
    <%= link_to "Print", customer_receipt_pos_transaction_path(@pos_transaction),
          class: "button button-outline button-small", target: "_blank", rel: "noopener" %>
    <%= link_to "Reprint", customer_receipt_pos_transaction_path(@pos_transaction, reprint: true),
          class: "button button-ghost button-small", target: "_blank", rel: "noopener" %>
  <% end %>

  <% overflow_commands = capture do %>
    <%= link_to "View detail",
          pos_overlay_receipt_detail_path(pos_transaction_id: @pos_transaction.id),
          class: "button button-ghost button-small",
          data: pos_overlay_turbo %>
    <% returnable = @pos_transaction.pos_line_items
         .where(status: "completed", direction: "sale")
         .where.not(line_kind: "stored_value")
         .any? { |line| line.remaining_returnable_quantity.positive? } %>
    <% if returnable && Current.user.can?("pos.return.create", store: Current.store) %>
      <%= button_to "Start linked return", start_linked_return_pos_transaction_path(@pos_transaction),
            method: :post, class: "button button-outline button-small",
            form: { data: { turbo_frame: "_top" } } %>
    <% end %>
    <% if @pos_transaction.reverses_pos_transaction_id.blank? && !@pos_transaction.post_void_transaction && !@pos_transaction.void_required_tenders? %>
      <%= link_to "Post-void", post_void_form_pos_transaction_path(@pos_transaction),
            class: "button button-ghost button-small", data: { turbo_frame: "_top" } %>
    <% end %>
  <% end %>

  <%= render "pos/shell",
        presentation: "receipt",
        presentation_label: "Receipt",
        session: pos_shell_session,
        primary: primary,
        summary: "".html_safe,
        primary_commands: primary_commands,
        overflow_commands: overflow_commands,
        hide_summary: true %>
<% else %>
  <% content_for :head do %>
    <meta name="turbo-cache-control" content="no-cache">
  <% end %>
  <% tender_mode = @presentation_state == "tender" %>
  <% recovery_mode = @presentation_state == "recovery" %>
  <% completion_failed = @completion_outcome == "failed" %>

  <% primary = capture do %>
    <% if recovery_mode %>
      <%= render "recovery_panel" %>
      <%= render "void_required_tenders" %>
    <% elsif tender_mode %>
      <section class="pos-sale-panel" aria-label="Payment">
        <% if completion_failed %>
          <div class="pos-region" role="status" aria-label="Completion failure">
            <h2>Completion failed</h2>
            <p>
              <strong>Code:</strong> <%= @completion_code.presence || "validation_failed" %><br>
              Transaction not completed. Receipt not assigned. Inventory not posted for this attempt.
            </p>
            <% if flash[:alert].present? %>
              <p><%= flash[:alert] %></p>
            <% end %>
            <% if Current.user.can?("pos.transaction.complete", store: Current.store) %>
              <%= form_with url: complete_pos_transaction_path(@pos_transaction), method: :post,
                    data: { turbo: false, action: "submit->pos-register#startProcessing" } do |form| %>
                <%= hidden_field_tag :completion_idempotency_key, @completion_idempotency_key %>
                <%= form.submit "Retry completion", class: "button button-primary",
                      data: { "pos-register-target": "completeButton" } %>
              <% end %>
            <% end %>
          </div>
        <% end %>
        <div class="pos-region">
          <h2>Payment</h2>
          <p class="pos-balance">
            <% if @balance_due_cents.to_i.positive? %>
              Amount due <%= pos_money(@balance_due_cents) %>
            <% elsif @balance_due_cents.to_i.negative? %>
              Refund due <%= pos_money(-@balance_due_cents) %>
            <% else %>
              Settled
            <% end %>
          </p>
        </div>
        <div class="pos-lines">
          <%= render "tenders" %>
          <%= render "tender_entry" %>
        </div>
      </section>
    <% else %>
      <section class="pos-sale-panel" aria-label="Transaction">
        <%= render "entry_intents" %>
        <%= render "scan_form" %>
        <%= render "line_items" %>
      </section>
    <% end %>
  <% end %>

  <% summary = capture do %>
    <%= render "customer_panel" %>
    <%= render "totals" %>
    <%= render "readiness_summary" %>
    <% unless tender_mode || recovery_mode %>
      <details class="pos-region">
        <summary>Secondary</summary>
        <%= render "secondary_actions" %>
      </details>
    <% end %>
  <% end %>

  <% summary_cta = capture do %>
    <%= render "primary_cta" %>
  <% end %>

  <% primary_commands = capture do %>
    <% if recovery_mode %>
      <span class="muted">Resolve Recovery in the primary workspace.</span>
    <% elsif tender_mode %>
      <% if @pos_transaction.editable? && !@workspace.forced_tender %>
        <%= link_to "Return to Transaction",
              pos_transaction_path(@pos_transaction, intent: @entry_intent, selected_line_id: @selected_line_id),
              class: "button button-outline button-small", data: pos_workspace_turbo %>
      <% elsif @workspace.forced_tender %>
        <span class="muted" role="status">Return blocked while tender is unresolved.</span>
      <% end %>
    <% else %>
      <%= render "selected_line_actions" %>
    <% end %>
  <% end %>

  <% overflow_commands = capture do %>
    <%= render "transaction_actions" %>
    <%= link_to "Back to register", register_path, class: "button button-ghost button-small",
          data: { turbo_frame: "_top" } %>
  <% end %>

  <%= render "pos/shell",
        presentation: pos_shell_presentation,
        presentation_label: pos_shell_presentation_label,
        session: pos_shell_session,
        primary: primary,
        summary: summary,
        summary_cta: summary_cta,
        primary_commands: primary_commands,
        overflow_commands: (recovery_mode ? nil : overflow_commands),
        hide_commands: recovery_mode %>
<% end %>
