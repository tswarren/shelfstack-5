<% if @pos_transaction.completed? %>
  <% content_for :head do %>
    <meta name="turbo-cache-control" content="no-cache">
  <% end %>
  <% primary = capture do %>
    <%= render "pos/receipt/workspace" %>
  <% end %>

  <% primary_commands = capture do %>
    <%= render "pos/receipt/commands" %>
  <% end %>

  <% overflow_commands = capture do %>
    <%= render "pos/receipt/overflow_commands" %>
  <% end %>

  <%= render "pos/shell",
        presentation: "receipt",
        presentation_label: "Receipt",
        session: pos_shell_session,
        primary: primary,
        summary: "".html_safe,
        primary_commands: primary_commands,
        overflow_commands: overflow_commands,
        hide_summary: true %>
<% else %>
  <% content_for :head do %>
    <meta name="turbo-cache-control" content="no-cache">
  <% end %>
  <% tender_mode = @presentation_state == "tender" %>
  <% recovery_mode = @presentation_state == "recovery" %>
  <% completion_failed = @completion_outcome == "failed" %>
  <% void_required_tenders = (@pos_tenders || []).select(&:void_required?) %>

  <% primary = capture do %>
    <% if recovery_mode %>
      <%= render "pos/recovery/workspace", void_required_tenders: void_required_tenders %>
    <% elsif tender_mode %>
      <% if completion_failed %>
        <div class="pos-region" role="status" aria-label="Completion failure">
          <h2>Completion failed</h2>
          <p>
            <strong>Code:</strong> <%= @completion_code.presence || "validation_failed" %><br>
            Transaction not completed. Receipt not assigned. Inventory not posted for this attempt.
          </p>
          <% if flash[:alert].present? %>
            <p><%= flash[:alert] %></p>
          <% end %>
          <p class="muted">Use Complete in the summary rail to retry.</p>
        </div>
      <% end %>
      <%= render "pos/tender/workspace", presentation: @tender_presentation %>
    <% else %>
      <section class="pos-sale-panel" aria-label="Transaction">
        <%= render "entry_intents" %>
        <%= render "scan_form" %>
        <%= render "line_items" %>
      </section>
    <% end %>
  <% end %>

  <% summary = capture do %>
    <% if recovery_mode %>
      <%= render "pos/recovery/affected_activity", void_required_tenders: void_required_tenders %>
    <% else %>
      <%= render "customer_panel" %>
      <%= render "totals" %>
      <%= render "readiness_summary" %>
      <% unless tender_mode %>
        <details class="pos-region">
          <summary>Secondary</summary>
          <%= render "secondary_actions" %>
        </details>
      <% end %>
    <% end %>
  <% end %>

  <% summary_cta = capture do %>
    <% unless recovery_mode %>
      <%= render "primary_cta" %>
    <% end %>
  <% end %>

  <% primary_commands = capture do %>
    <% if recovery_mode %>
      <span class="muted">Closed-list Recovery actions only — resolve in the primary workspace.</span>
    <% elsif tender_mode %>
      <%= render "pos/tender/commands", presentation: @tender_presentation %>
    <% else %>
      <%= render "selected_line_actions" %>
    <% end %>
  <% end %>

  <% overflow_commands = capture do %>
    <%= render "transaction_actions" %>
    <%= link_to "Back to register", register_path, class: "button button-ghost button-small",
          data: { turbo_frame: "_top" } %>
  <% end %>

  <%= render "pos/shell",
        presentation: pos_shell_presentation,
        presentation_label: pos_shell_presentation_label,
        session: pos_shell_session,
        primary: primary,
        summary: summary,
        summary_cta: summary_cta,
        primary_commands: primary_commands,
        overflow_commands: (recovery_mode ? nil : overflow_commands),
        hide_commands: recovery_mode %>
<% end %>
