<% identity = @summary.identity %>
<% store_name = @summary.store.name %>
<% content_for :title, identity.name %>

<%= render "shared/page_header",
      title: identity.name,
      subtitle: [
        identity.subtitle.presence,
        product_summary_bibliographic_line(identity),
        "Ops for #{store_name}"
      ].compact.join(" · "),
      breadcrumbs: [ { label: "Products", path: products_path }, { label: identity.name } ],
      actions: capture {
        if Current.user.can?("catalog.product.edit", store: Current.store)
          concat link_to("Edit", edit_product_path(@product), class: "button button-primary")
        end
        concat link_to("Back to products", products_path, class: "button button-outline")
      } %>

<%= render "products/attention", summary: @summary %>
<%= render "products/identity", summary: @summary %>
<%= render "products/standard_item", summary: @summary %>
<%= render "products/stock", summary: @summary %>
<%= render "products/store_operations", summary: @summary %>
<%= render "products/vendor_sources", summary: @summary %>
