<%# locals: summary: %>
<% stock = summary.stock %>
<% caps = summary.capabilities %>
<% store_name = summary.store.name %>
<aside class="store-status-rail" aria-label="Store status — <%= store_name %>">
  <h2 class="store-status-rail-title">Store status — <%= store_name %></h2>
  <% if !caps.stock_view %>
    <p class="muted">Stock details are not available with your permissions.</p>
  <% elsif stock.nil? %>
    <p class="muted">Stock is unavailable for this product at <%= store_name %>.</p>
  <% elsif stock.tracking_mode == "quantity" %>
    <div class="summary-strip">
      <div class="metric">
        <span class="metric-label">Available</span>
        <span class="metric-value"><%= stock.available %></span>
      </div>
      <div class="metric">
        <span class="metric-label">On hand</span>
        <span class="metric-value"><%= stock.on_hand %></span>
      </div>
      <div class="metric">
        <span class="metric-label">Reserved</span>
        <span class="metric-value"><%= stock.reserved %></span>
      </div>
      <div class="metric">
        <span class="metric-label">Unavailable</span>
        <span class="metric-value"><%= stock.unavailable %></span>
      </div>
      <% unless stock.on_order.nil? %>
        <div class="metric">
          <span class="metric-label">On order</span>
          <span class="metric-value"><%= stock.on_order %></span>
        </div>
      <% end %>
      <div class="metric">
        <span class="metric-label">Last received</span>
        <span class="metric-value metric-value-sm">
          <% if caps.receipt_view && stock.last_received_at %>
            <%= formatted_datetime(stock.last_received_at, format: :short) %>
          <% else %>
            —
          <% end %>
        </span>
      </div>
    </div>
  <% elsif stock.tracking_mode == "individual" %>
    <div class="summary-strip">
      <% unless stock.on_order.nil? %>
        <div class="metric">
          <span class="metric-label">On order</span>
          <span class="metric-value"><%= stock.on_order %></span>
        </div>
      <% end %>
      <div class="metric">
        <span class="metric-label">Last received</span>
        <span class="metric-value metric-value-sm">
          <% if caps.receipt_view && stock.last_received_at %>
            <%= formatted_datetime(stock.last_received_at, format: :short) %>
          <% else %>
            —
          <% end %>
        </span>
      </div>
    </div>
  <% else %>
    <p class="muted">This item is not inventory-tracked.</p>
    <% if caps.receipt_view %>
      <p class="muted">
        Last received:
        <%= stock&.last_received_at ? formatted_datetime(stock.last_received_at, format: :short) : "—" %>
      </p>
    <% end %>
  <% end %>
</aside>
